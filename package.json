{
  "name": "windway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:game": "node --max-semi-space-size=4 scripts/test-game.mjs && node --max-semi-space-size=4 scripts/test-barriers.mjs && node --max-semi-space-size=4 scripts/test-barriers.mjs --map=jungle && node --max-semi-space-size=4 scripts/test-maps.mjs && node --max-semi-space-size=4 scripts/test-snow.mjs && node --max-semi-space-size=4 scripts/test-ui.mjs && node --max-semi-space-size=4 scripts/test-hud-layout.mjs && npm run test:levels",
    "test:barriers": "node --max-semi-space-size=4 scripts/test-barriers.mjs",
    "test:maps": "node --max-semi-space-size=4 scripts/test-maps.mjs",
    "test:ui": "node --max-semi-space-size=4 scripts/test-ui.mjs",
    "test:snow": "node --max-semi-space-size=4 scripts/test-snow.mjs",
    "test:hud": "node --max-semi-space-size=4 scripts/test-hud-layout.mjs",
    "test:site": "node --max-semi-space-size=4 scripts/test-site.mjs",
    "test:build": "node --max-semi-space-size=4 scripts/test-build.mjs",
    "optimize:models": "node scripts/optimize-models.mjs",
    "test:levels": "node --max-semi-space-size=4 scripts/test-levels.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.12",
    "@react-three/rapier": "^1.5.0",
    "@types/three": "^0.181.0",
    "framer-motion": "^12.23.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.4.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
